# Copy to .env and adjust. Never commit .env.

# Transfer market platform: console (PS + Xbox) or pc
FCAST_PLATFORM=console

# SQLite database file (inside Docker: /data/fcast.db, set via docker-compose)
FCAST_DB_PATH=data/fcast.db

# Telegram bot (from @BotFather) and target chat id
FCAST_TELEGRAM_TOKEN=
FCAST_TELEGRAM_CHAT_ID=

# Collector interval in minutes
FCAST_COLLECT_INTERVAL_MIN=30
