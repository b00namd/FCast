# Copy to .env and adjust. Never commit .env.

# Transfer market platform: console (PS + Xbox) or pc
FCAST_PLATFORM=console

# SQLite database file (inside Docker: /data/fcast.db, set via docker-compose)
FCAST_DB_PATH=data/fcast.db

# Telegram bot (from @BotFather) and target chat id
FCAST_TELEGRAM_TOKEN=
FCAST_TELEGRAM_CHAT_ID=

# Collector interval in minutes
FCAST_COLLECT_INTERVAL_MIN=30

# Local timezone (quiet hours, CSV timestamps without offset)
FCAST_TIMEZONE=Europe/Berlin

# Manual price source: path to a CSV file (columns: ea_id,price[,platform,captured_at,name,...])
FCAST_MANUAL_CSV=

# Optional contact info appended to the HTTP User-Agent (e.g. an e-mail address)
FCAST_HTTP_CONTACT=

# Web price sources in priority order (futbin, futnext). Empty = CSV only.
FCAST_SOURCES=futbin,futnext
# priority (default) or rotate
FCAST_SOURCE_STRATEGY=priority
# Hours a source is paused after 403/429/bot challenge
FCAST_SOURCE_PAUSE_H=24

# Web dashboard login (required for `fcast serve`)
FCAST_WEB_USER=fcast
FCAST_WEB_PASSWORD=
